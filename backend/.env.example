# API 서버 포트 (프론트 vite.config.js 의 proxy 대상과 일치)
PORT=4700

# CORS 허용 오리진 (프론트 dev 서버)
CORS_ORIGIN=http://localhost:4699

# --- 네이버 로그인 OAuth 2.0 (실연동) ---
# 네이버 개발자센터(https://developers.naver.com)에서 애플리케이션 등록 후 발급.
# 미설정 시 프론트는 데모 모드로 동작(실제 네이버 호출 없이 로그인 흐름만 유지).
# Callback URL 은 네이버 개발자센터에 등록한 값과 반드시 일치해야 한다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_CALLBACK_URL=http://localhost:4699/api/auth/naver/callback

# --- 구글 로그인 OAuth 2.0 (실연동) ---
# Google Cloud Console(https://console.cloud.google.com/apis/credentials)에서
# "OAuth 클라이언트 ID(웹 애플리케이션)" 생성 후 발급. 미설정 시 프론트는 데모 모드로 동작.
# 승인된 리디렉션 URI에 GOOGLE_CALLBACK_URL 과 동일한 값을 등록해야 한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4699/api/auth/google/callback

# --- DB (호스팅: Supabase 확정 — 호스팅 Postgres로만 사용, API는 자체 backend에서 구현) ---
# 로컬 개발: docker-compose.yml의 postgres 컨테이너
DATABASE_URL=postgres://dealarchive:dealarchive@localhost:5432/dealarchive
# Supabase 사용 시: Dashboard 상단 "Connect" 버튼의 연결 문자열로 교체 (실제 값은 backend/.env 에만 — 이 파일은 커밋됨!).
#  - 비밀번호 양쪽의 대괄호 [ ] 는 자리표시 기호이므로 제거하고 입력.
#  - db:setup(DDL 적용)은 Direct connection(5432) 또는 Session pooler(5432) 사용.
#    Transaction pooler(6543)는 DDL에 부적합. Direct는 IPv6 전용이라 안 되면 Session pooler로.
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# DATABASE_URL=postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# --- 세션 (JWT httpOnly 쿠키 — 브라우저 재시작 후 로그인 유지) ---
# 긴 랜덤 문자열로 설정: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 미설정 시 세션 발급 없이 동작(매번 재로그인).
JWT_SECRET=

# --- 향후 연동용 (현재 미사용) ---
# ANTHROPIC_API_KEY=sk-ant-...        # AI 웰스 어드바이저 (Claude API)
# TRANCHING_API_BASE=https://...      # 한화 대체자산 공급망
