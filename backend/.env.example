# API 서버 포트 (프론트 vite.config.js 의 proxy 대상과 일치)
PORT=4700

# CORS 허용 오리진 (프론트 주소, 쉼표로 여러 개)
CORS_ORIGIN=http://localhost:4699

# --- DB ---
# 비워 두면 내장 Postgres(PGlite)를 backend/.data/pglite 에 만들어 사용 (설치 불필요, 첫 기동 시 시트 34건 자동 시드)
# 운영(Supabase): Dashboard 상단 "Connect"의 Session pooler(5432) 연결 문자열 — 실제 값은 backend/.env 에만 (이 파일은 커밋됨!)
# DATABASE_URL=postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# 로컬 docker postgres 를 쓸 때: docker compose up -d 후
# DATABASE_URL=postgres://dealarchive:dealarchive@localhost:5432/dealarchive

# PGlite 저장 위치 변경 (선택)
# PGLITE_DIR=./.data/pglite
