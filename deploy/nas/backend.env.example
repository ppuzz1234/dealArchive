# NAS 배포용 백엔드 환경변수 — 이 파일을 backend.env 로 복사해 실제 값 입력
# (backend.env 는 절대 git에 커밋하지 말 것)

NODE_ENV=production
PORT=4700

# 운영 프론트 주소 (Cloudflare Pages 도메인)
CORS_ORIGIN=https://your-domain.com

# Supabase Session pooler
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# 구글 OAuth — 운영용 콜백 URI를 Google Cloud Console에 추가 등록할 것
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.your-domain.com/api/auth/google/callback

# 네이버 OAuth (사용 시)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_CALLBACK_URL=https://api.your-domain.com/api/auth/naver/callback

# 세션 JWT — 운영용으로 새로 생성: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
